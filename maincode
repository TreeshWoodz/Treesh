<style>
  /* start Fonts */
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Special+Gothic+Expanded+One&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Doto:wght@100..900&display=swap');
	
  /* start Root */
:root {
  --gold: #c3ab69;
  --black: #121212;
  --white: #fff;
  --theme-color: hotpink;
  --border-color: rgba(255, 255, 255, 0.2);
  --main-font: "Manrope", sans-serif;
  --savionce-font: "Special Gothic Expanded One", sans-serif;
  --info-font: "Doto", sans-serif;
}

  /* Fonts | Doto */
.doto {
  font-optical-sizing: auto !important;
  font-weight: 400 !important;
  font-style: normal !important;
  font-variation-settings: "ROND" 0 !important;
}
  
  /* Everything */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  outline: none !important;
  box-sizing: border-box;
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
  scroll-behavior: smooth;
  -webkit-scroll-behavior: smooth;
  -moz-scroll-behavior: smooth;
}

  /* Remove Item */
.remove {
  display: none !important;
}

  /* Hide Item */
.hide {
  display: none !important;
}

  /* Body | HTML */
body,
html {
  width: 100%;
  height: auto;
  margin: 0 !important;
  touch-action: manipulation;
  overflow:auto;
  padding: 0 !important;
  background: var(--black) url();
  background-size: cover;
  background-position: center;
  color: var(--white);
  font-size: 1em;
  font-family: var(--main-font);
  font-weight: 400;
  scroll-behavior: smooth;
  text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.004);
  transition: opacity 1s ease-in, background-color 0.6s ease-in-out !important;
  scrollbar-face-color: var(--black);
  scrollbar-base-color: var(--black);
  scrollbar-arrow-color: gray;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  -ms-text-size-adjust: none;
  -webkit-text-size-adjust: none;
}

  /* fade Body | HTML */
body.fade,
html.fade {
  opacity: 0 !important;
}
  

  /* Display Based on Screen Type */
@media screen and (max-width: 600px) {
  .desktop_only {
    display: none !important;
  }
}

@media screen and (min-width: 601px) {
  .mobile_only {
    display: none !important;
  }
}

  /* List Styles */
ul,
li,
ol {
  list-style-type: none;
}

  /* Buttons */
button {
  position: relative;
  background:var(--theme-color);
    color:var(--white);
  font-family:var(--main-font);
}

  /* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background: var(--black);
}

::-webkit-scrollbar:hover {
  width: 12px;
  height: 12px;
}

::-webkit-scrollbar-thumb {
  background-color: var(--theme-color) !important;
  border-radius: 8px;
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--theme-color) !important;
}

  /* Dynamic Background */
  #bg {
    width:100%;
    height:100%;
    position:fixed;
    top:0;
    left:0;
    z-index:1;
    background: url('') center / cover no-repeat;
  }
  
  /* Player */
  #player {
    width:calc(100% - 30px);
    margin:auto;
    height:60px;
    position:fixed;
    bottom:30px;
    left:0;
    right:0;
    border-radius:5px;
    display:flex;
    justify-content:space-around;
    align-items:center;
    background:var(--black) url('') center / cover no-repeat;
    z-index:2;
  }
  
  #player button {
    background:var(--theme-color);
    color:var(--white);
  }
</style>

